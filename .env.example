# Local Docker development settings. Copy to `.env`; never commit the copied file.
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-password
MYSQL_PASSWORD=replace-with-the-same-local-mysql-password
MYSQL_USERNAME=root
REDIS_HOST=redis
REDIS_PORT=6379

# Public API URL used in OpenAPI/Swagger responses when deployed.
APP_PUBLIC_URL=

JWT_SECRET=replace-with-a-32-byte-or-longer-local-jwt-secret
HEADER=Authorization
PREFIX=Bearer
ACCESS_EXP=3600
REFRESH_EXP=1209600
STATE_EXP=300
STATE_PREFIX=state:

GEMINI_API_KEY=local-placeholder
GEMINI_MODEL=local-placeholder
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
FCM_ENABLED=false

# Hermes local webhook (keep the actual secret only in untracked .env or deployment secrets)
HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/balog-transactions
HERMES_WEBHOOK_SECRET=replace-with-hermes-subscription-secret
HERMES_WEBHOOK_ENABLED=false

# Balog MCP account link. Keep the actual bearer token only in untracked .env or deployment secrets.
MCP_CONNECTION_ID=hermes-local
MCP_CONSUMER_ID=hermes-agent
MCP_LINKED_USER_ID=replace-with-existing-balog-user-uuid
MCP_ENABLED=true
MCP_INITIAL_TOKEN=replace-with-a-long-random-mcp-bearer-token
